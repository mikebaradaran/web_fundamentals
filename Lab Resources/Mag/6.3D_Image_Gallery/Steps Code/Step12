	#stage {
		-webkit-perspective: 2500;
		position:			relative;
	}
	
	#rotate {
		-webkit-transform-origin: 0 0;
        -webkit-transform-style: preserve-3d;	
		-webkit-transition: 4s linear all;
		-webkit-transform: scale3d(1, 1, 1) rotateX(0deg) translateZ(0px);
	}
	
	#bottom {	
		position:			relative;
		width:				100%;
		height:				600px;
		margin:				auto;
		overflow:			hidden;	
		text-align:			center;

		
	}