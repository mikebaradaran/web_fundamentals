body {
		margin:		0;
		padding:	0;
		background:	#333;
	}
	
	#container {
		position: 	relative;
		width:		100%;
		height:		600px;
		padding-top:50px;		
		text-align:	center;	
		background:	transparent url(backgroundtexture.jpg) repeat top left;
	}
	
	#container ul.thumbnails {
		position:	relative;
		margin:		0;
		margin:		auto;
		padding:	0;
		width:		600px;
		height:		338px;
		overflow:	hidden;
		-webkit-box-shadow:	0px 5px 10px #333;
		box-shadow:	0px 5px 10px #333;
		border:		6px solid white;
	}
	
	#container ul.thumbnails li {
		position:	relative;
		float:		left;
		margin:		0;
		padding:	0;
		list-style:	none;
		cursor:		pointer;	
	}