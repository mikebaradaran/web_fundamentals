	/* The Sun */
	#solarsystem ol>li:nth-child(1) {
		width:			100px;
		height:			100px;
		border-radius:	50px;
		background:		red;
		position:		absolute;
		top:			500px;
		left:			500px;
		margin-left:	-50px;
		margin-top:		-50px;
	}
	
	/* Mercury */
