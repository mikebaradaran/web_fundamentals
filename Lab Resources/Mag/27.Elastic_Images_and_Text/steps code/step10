	$(document).ready(function(){
		maxwidth = 1200;
		minwidth = 480;
		parafontsize = 1.4;
		headfontsize = 2.05;

		$(window).resize(function(){
			width = parseInt($(this).width());
			if (width<minwidth) width=minwidth;
			if (width>maxwidth) width=maxwidth;
			pfontsize = parseFloat(parafontsize*(width/480))+"em";
			$("article p.intro").css({fontSize:pfontsize,lineHeight:(parseFloat(pfontsize)+(1.4-parseFloat(pfontsize)))+"em"});
			hfontsize = parseFloat(headfontsize*(width/480))+"em";
			$("article h2").css({fontSize:hfontsize});
		});